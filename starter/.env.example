# Copy this file to `.env` (same folder), then paste your real values in.
#
#     cp .env.example .env
#
# Never commit your `.env` — it holds your secret key.

# === REQUIRED — get these from your PocketRocks dashboard ===
POCKETROCKS_API_KEY=paste-your-api-key-here
POCKETROCKS_BOT_ID=paste-your-bot-id-here

# The server your bot connects to. Defaults to the hosted server if omitted.
#   Hosted server: wss://pocketrocks.xyz
#   Local server:  ws://localhost:3000
POCKETROCKS_SERVER_URL=wss://pocketrocks.xyz

# === OPTIONAL — safe defaults apply if you delete these ===
# POCKETROCKS_BOT_CAPACITY=1
# POCKETROCKS_LOG_LEVEL=INFO
