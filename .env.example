# ---------------------------------------------------------------------------
# PocketRocks bot configuration — TEMPLATE
#
# This is a template. Copy it to a file named `.env` in your own bot project,
# then fill in the two required values below. Never commit your real `.env`.
#
#     cp .env.example .env
#
# The SDK loads `.env` automatically from your project directory when the bot
# starts, so these become environment variables without any extra code.
# ---------------------------------------------------------------------------

# === REQUIRED — get these from your PocketRocks dashboard ===================

# Your bot's secret API key.
POCKETROCKS_API_KEY=paste-your-api-key-here

# The numeric ID of the bot you are connecting.
POCKETROCKS_BOT_ID=paste-your-bot-id-here

# The PocketRocks server your bot connects to.
#   - Hosted server: wss://pocketrocks.xyz   (note: wss, not ws)
POCKETROCKS_SERVER_URL=wss://pocketrocks.xyz


# === OPTIONAL — safe defaults are used if you delete/omit these ============
# You can leave everything below untouched until you need to tune behavior.

# How many concurrent games this bot advertises it can handle.
POCKETROCKS_BOT_CAPACITY=1

# Wire protocol version. Do not change unless the server asks you to.
POCKETROCKS_PROTOCOL_VERSION=2

# Concurrency / backpressure tuning for high-traffic bots.
POCKETROCKS_MAX_IN_FLIGHT_DECISIONS=4
POCKETROCKS_MAX_QUEUE_SIZE=32
POCKETROCKS_MIN_REMAINING_DEADLINE_MS_TO_START=100
POCKETROCKS_REQUEST_TIMEOUT_SLACK_MS=25

# Auto-reconnect behavior.
POCKETROCKS_RECONNECT=true
POCKETROCKS_RECONNECT_BASE_DELAY_SECONDS=0.5
# Backoff ceiling for transient failures (network blip, server restart) — fast recovery.
POCKETROCKS_RECONNECT_MAX_DELAY_SECONDS=8
# Backoff ceiling while the server rejects the bot (403 = deactivated). Much higher
# so an idle deactivated bot barely taxes the server; raise further (e.g. 300) for
# bots that may stay off for a long time.
POCKETROCKS_REJECTED_RECONNECT_MAX_DELAY_SECONDS=60

# Log verbosity for the SDK's own connection logging: DEBUG, INFO, WARNING, ERROR.
POCKETROCKS_LOG_LEVEL=INFO

# Adds the full DecisionContext to a decisionRejected event's details. It only
# adds detail — it never gates whether decisionRejected events fire.
POCKETROCKS_DEBUG=false
