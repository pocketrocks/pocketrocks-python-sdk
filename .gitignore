# Python bytecode / caches
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts / packaging
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Local secrets (never commit real credentials)
.env

# uv.lock IS committed. It pins only this repo's development and CI
# environment — installers of the published package resolve from
# pyproject.toml metadata and never read it, so locking here constrains
# nobody downstream. That our declared version floors actually work is
# proven separately by the `floors` CI job (uv sync --resolution lowest-direct).

# OS cruft
.DS_Store

# Controller scratch for subagent-driven execution (progress ledger, briefs).
.superpowers/

# Local agent task tracking. Canonical issues live in GitHub — see the docs
# policy in docs/README.md. Ignored here rather than relying on a contributor's
# global gitignore.
.beads/
